# ===================================================================
# Configuration locale de l'IA (Google Gemini) pour Sport Vision
# Copiez ce fichier vers .env.local et renseignez votre clé :
#   cp .env.example .env.local
#
# IMPORTANT : .env.local est ignoré par Git (.gitignore).
# Ne committez JAMAIS votre clé d'API dans le dépôt.
# ===================================================================

# Clé d'API Google Gemini (obtenez-en une sur https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# Modèle Gemini utilisé par le backend (défaut : gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Délai d'attente maximum en secondes pour les réponses de l'IA (défaut : 45)
GEMINI_TIMEOUT_SECONDS=45
